{
  "permissions": {
    "allow": [
      "Bash(node scripts/validate-data.js*)",
      "Bash(node .claude/skills/check-links/check-links.mjs*)",
      "Bash(node --check *)",
      "Bash(python -m http.server*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/pre-edit-guard.js\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/post-edit-check.js\"",
            "timeout": 30,
            "statusMessage": "Checking site JavaScript and data.js"
          }
        ]
      }
    ]
  }
}
